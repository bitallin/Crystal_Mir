# Zone identity used in logs.
CRYSTAL_ZONE_ID=zone-1

# Game listener. Use 0.0.0.0 for remote clients.
CRYSTAL_ZONE_IP=0.0.0.0
CRYSTAL_ZONE_PORT=7000

# The legacy status port uses the same bind address as the game port.
# Keep it private with a firewall or bind the zone to a private interface.
CRYSTAL_ZONE_STATUS_PORT=3000

CRYSTAL_ZONE_MAX_USER=50
CRYSTAL_ZONE_MAX_IP=5
CRYSTAL_ZONE_THREADS=2
CRYSTAL_ZONE_SAVE_DELAY_MINUTES=5
