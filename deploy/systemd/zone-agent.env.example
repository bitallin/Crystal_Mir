# Control plane used for registration, heartbeats and commands.
CRYSTAL_AGENT_CONTROL_URL=http://127.0.0.1:18088

# Optional when Control API has ControlApi:ApiKey configured.
# CRYSTAL_AGENT_API_KEY=change-me-service-api-key

CRYSTAL_ZONE_ID=zone-1
CRYSTAL_ZONE_NAME=Zone 1
CRYSTAL_AGENT_ID=zone-1-agent
CRYSTAL_AGENT_HOME=/var/lib/crystal/agent

# Runtime content root: Maps, Configs, Envir and the legacy Server.MirDB.
CRYSTAL_ZONE_HOME=/var/lib/crystal/zone
CRYSTAL_AGENT_ZONE_EXECUTABLE=/opt/crystal/zone/Crystal.ZoneServer

# Public key and key id used to verify published content snapshots.
CRYSTAL_ZONE_CONTENT_PUBLIC_KEY=/etc/crystal/release-public.pem
CRYSTAL_ZONE_CONTENT_KEY_ID=local-dev

# Optional timing overrides.
CRYSTAL_AGENT_POLL_SECONDS=2
CRYSTAL_AGENT_HEARTBEAT_SECONDS=5
CRYSTAL_AGENT_READY_TIMEOUT_SECONDS=300
CRYSTAL_AGENT_STOP_TIMEOUT_SECONDS=45
CRYSTAL_AGENT_LEASE_SECONDS=60
