# Copy to .env and replace every change-me value before running `docker compose up`.
# Never commit the populated .env or signing keys.

CRYSTAL_COMPOSE_WEB_PORT=18088
CRYSTAL_COMPOSE_POSTGRES_PORT=15432
CRYSTAL_COMPOSE_S3MOCK_PORT=19090
# Optional Compose network subnet. Change it if 172.28.0.0/16 conflicts locally.
CRYSTAL_COMPOSE_SUBNET=172.28.0.0/16

POSTGRES_PASSWORD=change-me-database-password

# At least 32 bytes. Generate with: openssl rand -base64 48
CRYSTAL_CONTROL_JWT_SIGNING_KEY=change-me-32-byte-minimum-jwt-signing-key

# At least 12 characters. Used only when the database has no administrator.
CRYSTAL_CONTROL_BOOTSTRAP_PASSWORD=change-me-admin-password

# Mounted read-only into the API. Run scripts/generate-release-keys.sh or create
# private.pem/public.pem manually. Sign/publish stay disabled until keys exist.
CRYSTAL_CONTROL_SIGNING_DIR=./artifacts/control-signing
CRYSTAL_CONTROL_RELEASE_SIGNING_KEY_ID=local-dev

# Asset files are read from this directory and mounted read-only at
# /var/lib/crystal/assets in the API container.
CRYSTAL_CONTROL_ASSET_ROOT=./tests/fixtures/content

# Optional image overrides for offline registries or cached images.
CRYSTAL_POSTGRES_IMAGE=postgres:16
CRYSTAL_REDIS_IMAGE=redis:7-alpine
CRYSTAL_S3MOCK_IMAGE=adobe/s3mock:5.2.3
CRYSTAL_CONTROL_API_IMAGE=crystal/control-api:dev
CRYSTAL_CONTROL_WEB_IMAGE=crystal/control-web:dev

# Browser client. The gateway and asset compiler must use the same build hash:
#   cd web-client && npm run build
#   node -e 'console.log(require("./web-client/dist/client-build.json").clientBuildHash)'
# With Settings.CheckVersion=true, add the same value to the zone server's
# Configs/Setup.ini [General] VersionHashValues or CRYSTAL_ZONE_VERSION_HASH_VALUES.
CRYSTAL_COMPOSE_WEB_GATEWAY_PORT=15080
CRYSTAL_COMPOSE_WEB_CLIENT_PORT=18089
CRYSTAL_WEB_ENVIRONMENT=Development
CRYSTAL_WEB_ZONE_TCP=host.docker.internal:7000
CRYSTAL_WEB_ALLOWED_ORIGINS=http://localhost:18089
CRYSTAL_WEB_ASSET_VERSION=dev
CRYSTAL_WEB_CLIENT_BUILD_HASH=sha256:dev
# Compose resolves this from the repository root. For Vite dev inside
# web-client/, pass an absolute path or ../artifacts/web-assets.
CRYSTAL_WEB_ASSET_ROOT=./artifacts/web-assets
